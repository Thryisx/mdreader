<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台输出固定 UTF-8，避免 Windows 默认 GBK 解码导致中文参数乱码 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level ${PID:- } --- [%thread] %logger{36} : %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="com.mdreader" level="DEBUG"/>
    <logger name="com.mdreader.mapper" level="INFO"/>
</configuration>
